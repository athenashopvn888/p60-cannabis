# PNY01 till. Copy into the environment.
# No DATABASE_URL: local and Vercel preview run the labeled demo (PIN 482913).
# VERCEL_ENV=production stays unconfigured until DATABASE_URL is set, so a live deploy is not a demo till.
# PNY_POS_DEMO=1 forces the demo (seeded only when the database is empty). PNY_POS_DEMO=0 turns it off.
# Do not point SETB_PRODUCTS_URL at the public store on-hand feed. On-hand fields are ignored.

DATABASE_URL=postgres://user:password@host/pny?sslmode=require
SHIFT_SECRET=replace-with-shift-secret
ROSTER_SECRET=replace-with-roster-secret
SCCX_POLL_SECRET=replace-with-sccx-poll-secret
SESSION_SECRET=replace-with-session-secret
CRON_SECRET=replace-with-cron-secret
ADMIN_SECRET=replace-with-admin-secret
GSHEET_ID=
GOOGLE_SA_PNY_CLIENT_EMAIL=
GOOGLE_SA_PNY_PRIVATE_KEY=
# Unset uses the PNY01 Apps Script menu feed, read-only. On-hand fields are ignored.
# SETB_PRODUCTS_URL=https://script.google.com/macros/s/AKfycbx09_sDal1eMVF1r-hUck4e7oq_XBHEWhGvA79JuhZNQ6P4CdhCas0xE3FfexWQ3hq4/exec?store=PNY01
SETB_SYNC_SECRET=
# PNY_POS_DEMO=1
